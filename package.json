{
  "name": "dormsync",
  "private": true,
  "version": "1.5.0",
  "description": "A self-hosted roommate status-sharing web app for four- and six-person dorms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgpt62ry7y-sys/dorm-status-hub.git"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-build-env.mjs",
    "dev": "vite --host 0.0.0.0",
    "preadmin": "node scripts/check-build-env.mjs",
    "admin": "vite --config admin/vite.config.ts --host 127.0.0.1 --port 5176",
    "dev:test": "node scripts/start-local-test.mjs",
    "prebuild": "node scripts/check-build-env.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "predeploy": "npm run check:release",
    "check:release": "node scripts/check-release-notes.mjs",
    "test": "npm run test:account && npm run test:release && npm run test:auth",
    "test:account": "node tests/device-account.test.cjs",
    "test:release": "node tests/release-notice.test.cjs",
    "test:auth": "node tests/room-auth.test.cjs",
    "deploy:api": "node scripts/deploy-cloudbase.mjs api",
    "deploy:web": "node scripts/deploy-cloudbase.mjs web",
    "deploy": "npm run build && npm run deploy:api && npm run deploy:web"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.9.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
