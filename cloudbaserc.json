{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "dormsyncApi",
      "dir": "cloudfunctions/api",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "description": "DormSync room, member, status and invite API",
      "aclRule": {
        "*": {
          "invoke": "auth.loginType != 'ANONYMOUS' && auth != null"
        },
        "dormsyncApi": {
          "invoke": "auth != null"
        }
      }
    },
    {
      "name": "dormsyncHttp",
      "dir": "cloudfunctions/api",
      "type": "HTTP",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "public": true,
      "gatewayPath": "/dormsyncApi",
      "description": "DormSync public HTTP API"
    },
    {
      "name": "dormsyncCleanup",
      "dir": "cloudfunctions/api",
      "runtime": "Nodejs20.19",
      "handler": "index.cleanup",
      "timeout": 60,
      "memorySize": 256,
      "description": "DormSync expired room cleanup",
      "triggers": [
        {
          "name": "hourly-room-cleanup",
          "type": "timer",
          "config": "0 0 * * * * *"
        }
      ]
    }
  ]
}
