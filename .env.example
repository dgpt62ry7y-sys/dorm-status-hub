VITE_CLOUDBASE_ENV_ID=your-env-id
VITE_DORMSYNC_API_URL=https://your-api-domain/dormsyncApi
DORMSYNC_CREATOR_KEY=your-room-creation-key
DORMSYNC_ADMIN_KEY=your-local-admin-key
# Required for Bark on iPhone: exactly 64 hexadecimal characters.
DORMSYNC_BARK_ENCRYPTION_KEY=your-bark-encryption-key-64-hex
# Optional: defaults to the public ntfy.sh service.
# DORMSYNC_NTFY_SERVER=https://ntfy.sh
# DORMSYNC_NTFY_PUBLIC_URL=https://ntfy.sh
